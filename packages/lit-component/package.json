{
  "name": "lit-component",
  "version": "0.1.0",
  "description": "Webcomponent lit-element following open-wc recommendations",
  "license": "MIT",
  "author": "lit-element",
  "type": "module",
  "exports": {
    ".": "./dist/src/index.js",
    "./my-custom-element.js": "./dist/src/my-custom-element.js",
    "./custom-elements": "./dist/custom-element-jsx.d.ts"
  },
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "scripts": {
    "analyze": "cem analyze --config custom-elements-manifest.config.js",
    "build": "tsc && npm run analyze -- --exclude dist",
    "clean": "rimraf dist",
    "dev": "tsc && concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"web-dev-server\"",
    "format": "run-p format:*",
    "format:lint": "eslint --fix .",
    "format:prettier": "prettier \"**/*.ts\" --write",
    "lint": "run-p lint:*",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier \"**/*.ts\" --check",
    "prepublish": "tsc && npm run analyze -- --exclude dist",
    "test": "tsc && wtr --coverage",
    "test:watch": "tsc && concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"wtr --watch\""
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.10.4",
    "@open-wc/testing": "^4.0.0",
    "@types/mocha": "^10.0.7",
    "@web/dev-server": "^0.4.6",
    "@web/test-runner": "^0.18.2",
    "concurrently": "^8.2.2",
    "custom-element-jsx-integration": "^1.6.0",
    "custom-element-react-wrappers": "^1.7.0",
    "tslib": "^2.6.3",
    "typescript": "^5.5.3"
  },
  "customElements": "dist/custom-elements.json"
}
