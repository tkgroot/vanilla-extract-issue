{
  "name": "web-components-react-vanilla-extract",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:app": "npm run dev --workspace=app",
    "dev:lit": "npm run dev --workspace=lit-component",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "prettier": {
    "arrowParens": "avoid",
    "plugins": [
      "prettier-plugin-packagejson"
    ],
    "printWidth": 120,
    "singleQuote": true
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.5.3",
    "prettier-plugin-packagejson": "^2.5.10",
    "sort-package-json": "^3.0.0"
  }
}
